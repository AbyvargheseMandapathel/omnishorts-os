DirectoryIndex index.php

# Hostinger / cPanel shared hosting
# ---------------------------------
# The domain's document root points at this folder (e.g. public_html), but the
# Laravel entry point lives in public/index.php. This file routes every request
# into /public — public/.htaccess then forwards non-file paths to index.php.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Root URL → public/index.php directly
    RewriteRule ^$ public/index.php [L]

    # Serve real files at the document root directly (e.g. health.php)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Allow /videos/ directory to be served directly (FTP video disk)
    RewriteRule ^videos/ - [L]

    # Everything else → public/
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
