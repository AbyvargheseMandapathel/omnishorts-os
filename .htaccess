DirectoryIndex index.php

# Hostinger / cPanel shared hosting
# ---------------------------------
# The domain's document root points at this folder (e.g. public_html), but the
# Laravel entry point lives in public/index.php. This file routes every request
# into /public — public/.htaccess then forwards non-file paths to index.php.
#
# On servers where the document root already points at public/, this file sits
# outside the document root and is never read, so it is harmless everywhere.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/dirs at the document root directly (e.g. a /videos
    # folder written by the FTP video disk) instead of rewriting them into
    # /public — without this, /videos/foo.mp4 would 404 through Laravel.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't re-enter once a request is already inside /public.
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
